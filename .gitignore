# 图片文件 — 禁止进入知识图谱
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.webp
*.bmp
*.ico

# SVG 例外：方法论/决策文档的手工配图可入库（SVG 是文本格式，git diff 友好）
!50-经验/*.svg
!40-决策/*.svg

# PPT/Word 导入产物
media/
**/assets/

# Python 编译缓存
__pycache__/
*.pyc
.prompt-src/_build/

# 系统文件
.DS_Store
Thumbs.db

# Obsidian 运行时
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/plugins/**/data*.json

# 运行时产物（不入版本控制）
_temp/
