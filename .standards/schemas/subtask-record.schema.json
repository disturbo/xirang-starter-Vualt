{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Subtask Runtime Record",
  "description": "V8.5 子任务运行时记录 schema。每个 spawn 出的子 Agent 在 _temp/{task_id}/subtasks/{sub_id}.json 有一份。",
  "version": "1.0.0",
  "type": "object",
  "required": ["task_id", "sub_id", "parent_agent", "parent_task_id", "spawn_ts", "state", "task_type", "task_name"],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^T-\\d{8}-\\d{2,3}$",
      "description": "父任务 ID（格式: T-YYYYMMDD-NN）"
    },
    "sub_id": {
      "type": "string",
      "pattern": "^sub-[a-z0-9-]+$",
      "description": "子任务唯一标识（格式: sub-XX 或 sub-descriptive-name）"
    },
    "parent_agent": {
      "type": "string",
      "enum": ["claudian", "dongfeng", "xiaochong", "toubao", "workbuddy", "qingmeisu", "hongmeisu"],
      "description": "父 Agent ID"
    },
    "parent_task_id": {
      "type": "string",
      "description": "父任务 ID（通常与 task_id 相同）"
    },
    "spawn_ts": {
      "type": "string",
      "format": "date-time",
      "description": "创建时间（ISO 8601）"
    },
    "state": {
      "type": "string",
      "enum": ["CREATED", "RUNNING", "SUCCESS", "FAILED", "TIMEOUT", "RETRYING", "RETRY_EXHAUSTED", "RECLAIMED", "ESCALATED", "COLLECTED", "DESTROYED"],
      "description": "当前状态（对齐 V8 10 态状态机）"
    },
    "model": {
      "type": "string",
      "description": "使用的模型（如 sonnet, haiku, opus, deepseek-v4）"
    },
    "task_type": {
      "type": "string",
      "enum": ["prototype", "code", "prd", "research", "spec", "review", "batch", "diagram"],
      "description": "任务类型（对齐 xirang-spawn.py TASK_TYPES）"
    },
    "task_name": {
      "type": "string",
      "description": "任务名称（人类可读）"
    },
    "budget": {
      "type": "object",
      "properties": {
        "max_tokens": { "type": "integer", "minimum": 0 },
        "timeout_sec": { "type": "integer", "minimum": 0 },
        "cost_ceiling_cny": { "type": "number", "minimum": 0 }
      },
      "description": "预算约束"
    },
    "write_scope": {
      "type": "array",
      "items": { "type": "string" },
      "description": "允许写入的路径列表"
    },
    "tool_blacklist": {
      "type": "array",
      "items": { "type": "string" },
      "description": "禁止使用的工具/命令列表"
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "ts"],
        "properties": {
          "role": {
            "type": "string",
            "enum": ["spawn", "heartbeat", "send_msg", "result", "error"]
          },
          "ts": { "type": "string", "format": "date-time" },
          "content": { "type": "string" },
          "progress": { "type": "string" },
          "pct": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      },
      "description": "通信消息记录"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "type"],
        "properties": {
          "path": { "type": "string" },
          "type": { "type": "string" },
          "size_bytes": { "type": "integer" }
        }
      },
      "description": "产出物清单"
    },
    "cost": {
      "type": "object",
      "properties": {
        "tokens": { "type": "integer", "minimum": 0 },
        "cost_cny": { "type": "number", "minimum": 0 },
        "model": { "type": "string" }
      },
      "description": "实际消耗"
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "ts"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "ts": { "type": "string", "format": "date-time" },
          "reason": { "type": "string" }
        }
      },
      "description": "状态转换历史"
    },
    "error": {
      "type": ["object", "null"],
      "properties": {
        "code": { "type": "string", "description": "错误代码（如 E-TIMEOUT, E-FORMAT）" },
        "message": { "type": "string" },
        "retry_count": { "type": "integer" }
      },
      "description": "错误信息（无错误时为 null）"
    },
    "collected_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "父 Agent 收集结果的时间"
    },
    "destroyed_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "记录销毁时间"
    }
  }
}
