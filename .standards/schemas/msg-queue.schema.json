{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Agent Message Queue Entry",
  "description": "V8.5 Agent 间结构化消息格式。存储于 _temp/msg-queue.jsonl，每行一条消息。",
  "version": "1.0.0",
  "type": "object",
  "required": ["msg_id", "ts", "from", "to", "type", "priority", "payload", "status"],
  "properties": {
    "msg_id": {
      "type": "string",
      "pattern": "^msg-\\d+-[a-f0-9]{4}$",
      "description": "消息唯一ID，格式: msg-{unix_ms}-{4位hex}"
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "description": "消息创建时间（ISO 8601 + 时区）"
    },
    "from": {
      "type": "string",
      "description": "发送方 agent_id 或 'system'"
    },
    "to": {
      "type": "string",
      "description": "接收方 agent_id 或 'broadcast'（广播给所有Agent）"
    },
    "type": {
      "type": "string",
      "enum": ["cost_alert", "escalation", "handoff", "spawn_request", "result_ready", "system"],
      "description": "消息类型"
    },
    "priority": {
      "type": "string",
      "enum": ["P0", "P1", "P2", "P3"],
      "description": "优先级: P0=阻断 P1=高 P2=常规 P3=通知"
    },
    "payload": {
      "type": "object",
      "description": "消息载荷（type-specific 结构，不做强约束）"
    },
    "status": {
      "type": "string",
      "enum": ["pending", "read", "acked", "expired"],
      "description": "消息状态: pending→read→acked | pending→expired"
    },
    "expires_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "过期时间，null=永不过期"
    },
    "ref_task_id": {
      "type": ["string", "null"],
      "description": "关联任务ID（可选，便于溯源）"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "payload_cost_alert": {
      "description": "cost_alert 类型的 payload 结构",
      "type": "object",
      "properties": {
        "task_id": { "type": "string" },
        "pct": { "type": "number", "description": "当前成本占比%" },
        "spent_cny": { "type": "number" },
        "ceiling_cny": { "type": "number" },
        "agent": { "type": "string" }
      }
    },
    "payload_escalation": {
      "description": "escalation 类型的 payload 结构",
      "type": "object",
      "properties": {
        "level": { "type": "string", "enum": ["L0", "L0.5", "L1", "L2", "L3"] },
        "reason": { "type": "string" },
        "task_id": { "type": "string" },
        "from_agent": { "type": "string" }
      }
    },
    "payload_result_ready": {
      "description": "result_ready 类型的 payload 结构",
      "type": "object",
      "properties": {
        "task_id": { "type": "string" },
        "sub_id": { "type": "string" },
        "state": { "type": "string" },
        "artifacts": { "type": "integer" }
      }
    }
  }
}
