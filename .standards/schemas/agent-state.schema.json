{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Agent State File Frontmatter",
  "description": "V8.5 统一 Agent 状态文件 schema。所有 02-项目管理/智能体状态/*.md 的 YAML frontmatter 必须符合此定义。",
  "version": "1.0.0",
  "type": "object",
  "required": ["agent_id", "agent_name", "agent_role", "platform", "status"],
  "properties": {
    "agent_id": {
      "type": "string",
      "enum": ["claudian", "dongfeng", "xiaochong", "toubao", "workbuddy", "qingmeisu", "hongmeisu"],
      "description": "Agent 唯一标识符"
    },
    "agent_name": {
      "type": "string",
      "description": "Agent 中文名"
    },
    "agent_role": {
      "type": "string",
      "description": "Agent 职责描述"
    },
    "platform": {
      "type": "string",
      "enum": ["Codebuddy", "OpenClaw", "Hermes", "Codex", "Claudian", "Claudian（已下线）"],
      "description": "Agent 所在平台（Claudian = Obsidian 嵌入式 Claude）"
    },
    "status": {
      "type": "string",
      "enum": ["idle", "busy", "cooling", "error", "standby", "retired"],
      "description": "当前运行状态（retired = 永久退役，不再接收任务）"
    },
    "current_task": {
      "type": ["string", "null"],
      "description": "当前任务名称（idle 时为 null）"
    },
    "current_task_id": {
      "type": ["string", "null"],
      "description": "当前任务卡 ID（格式: T-YYYYMMDD-NN）"
    },
    "last_heartbeat": {
      "type": "string",
      "format": "date-time",
      "description": "最后心跳时间（ISO 8601 + 时区）"
    },
    "spawn_count": {
      "type": "integer",
      "minimum": 0,
      "description": "当前活跃子任务数量"
    },
    "active_subtasks": {
      "type": "array",
      "items": { "type": "string" },
      "description": "当前活跃子任务 ID 列表（格式: sub-XX）"
    },
    "cooldown_until": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "冷却截止时间（仅限有冷却的 Agent）"
    },
    "cost_tracking": {
      "type": "object",
      "properties": {
        "session_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "本次会话消耗 token"
        },
        "session_cost_cny": {
          "type": "number",
          "minimum": 0,
          "description": "本次会话消耗（元）"
        },
        "weekly_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "本周累计 token"
        },
        "weekly_cost_cny": {
          "type": "number",
          "minimum": 0,
          "description": "本周累计成本（元）"
        },
        "model_used": {
          "type": ["string", "null"],
          "description": "当前使用模型"
        },
        "last_reset": {
          "type": "string",
          "format": "date",
          "description": "上次重置日期"
        }
      },
      "required": ["session_tokens", "session_cost_cny", "weekly_tokens", "weekly_cost_cny"]
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Obsidian 标签"
    }
  },
  "additionalProperties": false
}
